# Copy to deploy/vps/.env on the server. Not secret, but kept out of git.
# Point each host at the server with an A record (DNS only) before you set it: Let's Encrypt limits failed attempts.
SITE_HOST=gmechain.xyz
RPC_HOST=rpc.gmechain.xyz
RPC_TESTNET_HOST=rpc.testnet.gmechain.xyz
# optional second hostname for the site
SITE_ALIAS=
# Nitro log level: INFO, WARN or DEBUG
NITRO_LOG_LEVEL=INFO
