# Image for the long-running chain services (keeper, monitor, claimer, credits, media). Build context: chain/
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY scripts/ ./scripts/
# /data: state of the credits service and the launchpad images (named volumes start with this owner)
RUN mkdir -p /data/media && chown -R node:node /data
# keys come from env_file at run time, never from the image
USER node
EXPOSE 8080
