{
  "name": "gmechain-walletkit",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.jsx src/viem.js --bundle --splitting --external:../config.js --minify --format=esm --target=es2020 --outdir=../site/js/walletkit --entry-names=[name] --chunk-names=c-[hash] --define:process.env.NODE_ENV=\\\"production\\\" --loader:.js=jsx && node -e \"require('fs').copyFileSync('node_modules/@rainbow-me/rainbowkit/dist/index.css','../site/walletkit.css')\""
